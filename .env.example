# Hivemind local configuration

# Database and cache
DATABASE_URL=postgres://hivemind:replace-with-a-strong-password@localhost:5432/hivemind
REDIS_URL=redis://localhost:6379
POSTGRES_USER=hivemind
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=hivemind
# Override these if the default host ports are already in use.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
NODEPOOL_GRPC_HOST_PORT=50051
TORRENT_TRACKER_HOST_PORT=6969
TORRENT_SEED_HOST_PORT=6881
MASTER_HTTP_HOST_PORT=8082
WORKER_GRPC_HOST_PORT=50053
WORKER_CONTROL_HOST_PORT=18080
MASTER_UI_HOST_PORT=3000
WORKER_UI_HOST_PORT=3001
SITE_HOST_PORT=8080
# Override these only when an isolated compose deployment must not reuse the
# default persistent volumes (for example, release smoke or CI).
REDIS_VOLUME_NAME=hivemind-redis-data
POSTGRES_VOLUME_NAME=hivemind-postgres-data
HIVEMIND_DATA_VOLUME_NAME=hivemind-data
NODEPOOL_TORRENTS_VOLUME_NAME=hivemind-nodepool-torrents
NODEPOOL_TASK_PACKAGES_VOLUME_NAME=hivemind-nodepool-task-packages
MASTER_TASK_REFERENCES_VOLUME_NAME=hivemind-master-task-references
MASTER_TORRENTS_VOLUME_NAME=hivemind-master-torrents
WORKER_TASK_DOWNLOADS_VOLUME_NAME=hivemind-worker-task-downloads
WORKER_TORRENTS_VOLUME_NAME=hivemind-worker-torrents

# Service listen addresses
MASTER_HTTP_ADDR=0.0.0.0:8082
NODEPOOL_GRPC_ADDR=0.0.0.0:50051
WORKER_GRPC_ADDR=0.0.0.0:50053
WORKER_CONTROL_HTTP_ADDR=127.0.0.1:18080

# Address advertised by a worker to nodepool.
# Set this when the worker is reachable at a different host/IP than WORKER_GRPC_ADDR.
# WORKER_ADVERTISE_ADDR=worker-hostname:50053

# Worker identity
WORKER_ID=worker-1
WORKER_LOCATION=local

# Authentication
JWT_SECRET=change-me-in-production
# Test-only compose overrides; use unique values in CI/local test environments.
TEST_POSTGRES_PASSWORD=replace-with-a-test-password
TEST_JWT_SECRET=replace-with-a-test-secret-at-least-32-bytes
# Worker execution trust. Nodepool signs execution tokens with this Ed25519
# private key; use one line with literal \n separators in an environment file.
# Generate a production key with: openssl genpkey -algorithm Ed25519
WORKER_EXECUTION_PRIVATE_KEY_PEM=
# Self-hosted workers must use the public key matching the private key above.
WORKER_EXECUTION_PUBLIC_KEY_PEM=
# Optional preprovisioned worker token. Leave blank to register after Worker UI login.
WORKER_NODEPOOL_TOKEN=
# Comma-separated admin usernames allowed to access /api/admin/* endpoints
HIVEMIND_ADMIN_USERS=testuser
# Per-user task submissions allowed within a rolling 1-minute window (0 = unlimited)
HIVEMIND_TASK_SUBMIT_LIMIT_PER_MINUTE=60

# Torrent task package distribution
TORRENT_API_DIR=./api/torrents
TORRENT_BT_DIR=./bt_torrents
TORRENT_ANNOUNCE_URL=http://localhost:6969/announce
TORRENT_TASK_ARTIFACT_BASE_URL=

# Executor
MONTY_EXECUTABLE=monty.exe
# Managed-proof settlement rollout. Applies to the NODEPOOL, which owns the
# dispatcher that decides how a managed task settles; it does nothing on a
# worker. Keep enforce in production; use observe only during an explicitly
# monitored migration and off only for emergency rollback.
MANAGED_PROOF_ROLLOUT_MODE=enforce
# Worker-side prover sidecar. RISC Zero supports Linux/macOS prover hosts only.
# Build it with scripts/build-managed-prover.sh and the worker image bakes it in
# at /app/prover/hivemind-managed-proof-prover, which is the Compose default.
# Managed tasks fail closed whenever the sidecar cannot be spawned.
MANAGED_PROVER_EXECUTABLE=
# A single managed-function proof currently takes roughly 570-580 seconds.
MANAGED_PROVER_TIMEOUT_SECS=900
EXECUTOR_SANDBOX_DIR=./sandbox
EXECUTOR_MAX_CPU_PERCENT=80
EXECUTOR_MAX_MEMORY_MB=4096
EXECUTOR_TASK_TIMEOUT_SECS=3600
EXECUTOR_MAX_CONCURRENT_TASKS=4

# VPN / Headscale coordination
HEADSCALE_URL=http://localhost:8080
HEADSCALE_API_KEY=
VPN_BASE_VIRTUAL_IP=100.64.0.0
VPN_NETWORK=100.64.0.0/10

# Frontend
VITE_API_BASE=http://localhost:8082
VITE_WORKER_CONTROL_BASE=http://localhost:18080
# Official website backend calls nodepool over gRPC server-side.
WEBSITE_NODEPOOL_GRPC_ADDR=localhost:50051

# Logging
LOG_LEVEL=info
DEBUG=false
