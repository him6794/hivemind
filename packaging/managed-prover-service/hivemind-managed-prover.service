[Unit]
Description=Hivemind managed proof provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hivemind-prover
Group=hivemind-prover
ExecStart=/opt/hivemind/bin/hivemind-managed-prover-service
EnvironmentFile=/etc/hivemind-managed-prover/provider.env
WorkingDirectory=/opt/hivemind
StateDirectory=hivemind-managed-prover
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hivemind-managed-prover
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
