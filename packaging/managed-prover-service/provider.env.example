# Copy this file to an operator-only provider.env and replace every placeholder.
# Do not commit the copied file or place Nodepool's private signing key here.

# Public half of the Nodepool-only managed-proof Ed25519 signing key.
MANAGED_PROOF_AUTH_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_NODEPOOL_MANAGED_PROOF_PUBLIC_KEY\n-----END PUBLIC KEY-----

# Admission mode. The default (public_dynamic) accepts any Worker holding a
# valid Nodepool per-attempt proof authorization plus this provider's own
# runtime/backend/queue policy — no per-Worker registry is required.
HIVEMIND_WORKER_ADMISSION_MODE=public_dynamic

# Only for explicitly selected private_static deployments: the static Worker-ID
# capability gate. Public deployments must leave this unset; it must never be
# required for a Worker to join or prove.
# HIVEMIND_WORKER_ADMISSION_MODE=private_static
# HIVEMIND_MANAGED_DSL_TRUSTED_WORKER_CAPABILITIES={"worker-id":{"owner":"worker-owner","registrations":[{"backend_id":"dsl-default","runtime_version":"managed-function-v0","semantics_manifest_sha256":"REPLACE_WITH_CANONICAL_MANAGED_DSL_SEMANTICS_SHA256","max_usage_units":100000,"max_output_bytes":65536}]}}

# The container supplies these defaults; they are listed here for clarity.
MANAGED_PROVER_SERVICE_ADDR=0.0.0.0:50054
MANAGED_PROVER_SERVICE_EXECUTABLE=/app/prover/hivemind-managed-proof-prover
MANAGED_PROVER_STATE_DIR=/var/lib/hivemind-managed-prover
MANAGED_PROVER_QUEUE_CAPACITY=1
MANAGED_PROVER_TIMEOUT_SECS=1200
MANAGED_PROVER_TLS_SERVER_CERT_PATH=/etc/hivemind-managed-prover/server.crt
MANAGED_PROVER_TLS_SERVER_KEY_PATH=/etc/hivemind-managed-prover/server.key
MANAGED_PROVER_TLS_CLIENT_CA_PATH=/etc/hivemind-managed-prover/worker-client-ca.crt
