# Local environment
.env
.env.*
!.env.example
!frontend/.env.example

# Dependency caches
node_modules/
.cargo/
# ...except two tracked cargo configs. The audit policy records the prover's
# accepted advisories (see docs/zk-managed-proof-dependency-audit.md), and the
# workspace config carries the MinGW linker that the documented
# x86_64-pc-windows-gnu test path needs to be reproducible on another machine.
!zkvm/managed-proof/.cargo/
!zkvm/managed-proof/.cargo/audit.toml
!hivemind-rs/.cargo/
!hivemind-rs/.cargo/config.toml
.rustup/
.omo/
# Build outputs and compiler caches
target/
subagents/sandbox-egress/target/
hivemind-rs/target-alt/
hivemind-rs/target-local/
tmp/

# Downloaded dependencies and release artifacts
.cache/
artifacts/
vendor/
# Staged managed-proof prover sidecar: ~95 MB of Linux build output produced by
# scripts/build-managed-prover.sh. The staging directory itself stays tracked.
packaging/managed-prover/hivemind-managed-proof-prover

# Frontend build outputs (Next.js standalone, Vite dist, Vite dep cache)
dist/
.next/
.vite/

# Python caches
__pycache__/
scripts/__pycache__/
*.py[cod]

# Logs and test artifacts
*.log
test_logs/
worklog/

# Local data and backups
docs_backup_*/
api/
!frontend/src/app/api/
!frontend/src/app/api/[...path]/
!frontend/src/app/api/[...path]/route.ts
hivemind-rs/api/
hivemind-rs/bt_torrents/
test_tasks/

# Misc local state
*.db
*.sqlite
*.sqlite3
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
*.bak
*.backup
*.orig
*.old
worker_credentials.json
task_state.json
job_queue.json
config/local.yaml
config/secrets.yaml
workspace-*.tar
