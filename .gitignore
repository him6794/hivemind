# Local environment
.env
.env.*
!.env.example
!frontend/.env.example

# Dependency caches
node_modules/
.cargo/
# Two tracked cargo configs: the workspace config carries the MinGW
# linker that the documented x86_64-pc-windows-gnu test path needs to
# be reproducible on another machine.
!hivemind-rs/.cargo/
!hivemind-rs/.cargo/config.toml
.rustup/
.omo/
# Build outputs and compiler caches
target/
/target-v0-retirement-check/
subagents/sandbox-egress/target/
hivemind-rs/target-alt/
hivemind-rs/target-local/
tmp/

# Downloaded dependencies and release artifacts
.cache/
artifacts/
vendor/

# Frontend build outputs (Next.js static export, Vite dist, Vite dep cache)
dist/
.next/
.vite/
frontend/out/
# TypeScript incremental build info written by next build
*.tsbuildinfo

# Python caches
__pycache__/
scripts/__pycache__/
*.py[cod]

# Logs and test artifacts
*.log
test_logs/
worklog/

# Local data and backups
docs_backup_*/
api/
!frontend/functions/api/
hivemind-rs/api/
hivemind-rs/bt_torrents/
test_tasks/

# Local agent/developer tooling state (keep shared instructions/config tracked)
/.claude/settings.local.json
/.claude/worktrees/
/.claude/scheduled_tasks.lock
/.codegraph/
/.review/

# Misc local state
*.db
*.sqlite
*.sqlite3
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
*.bak
*.backup
*.orig
*.old
worker_credentials.json
task_state.json
job_queue.json
config/local.yaml
config/secrets.yaml
workspace-*.tar
