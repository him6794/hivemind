# Local environment
.env
.env.*
!.env.example
!frontend/.env.example

# Dependency caches
node_modules/
.cargo/
.rustup/
.omo/
# Build outputs and compiler caches
target/
subagents/sandbox-egress/target/
hivemind-rs/target-alt/
hivemind-rs/target-local/
tmp/

# Downloaded dependencies and release artifacts
.cache/
artifacts/
vendor/

# Frontend build outputs (Next.js standalone, Vite dist, Vite dep cache)
dist/
.next/
.vite/

# Python caches
__pycache__/
scripts/__pycache__/
*.py[cod]

# Logs and test artifacts
*.log
test_logs/
worklog/

# Local data and backups
docs_backup_*/
api/
!frontend/src/app/api/
!frontend/src/app/api/[...path]/
!frontend/src/app/api/[...path]/route.ts
hivemind-rs/api/
hivemind-rs/bt_torrents/
test_tasks/

# Misc local state
*.db
*.sqlite
*.sqlite3
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
*.bak
*.backup
*.orig
*.old
worker_credentials.json
task_state.json
job_queue.json
config/local.yaml
config/secrets.yaml
workspace-*.tar
